# DeepSeek：复制本文件为 .env，然后只填写 DEEPSEEK_API_KEY。
# 禁止在示例文件中填写真实密钥，也不要将密钥提交到 Git。
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=10

# 前端 API 地址
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_CSRF_COOKIE_NAME=safebank_csrf

# MySQL 持久化；未填写完整时自动使用内存仓库。
DATABASE_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=safebank_agent
DB_USER=safebank_app
DB_PASSWORD=

# 认证配置。JWT_SECRET_KEY 至少 32 个随机字符，禁止提交真实值。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=safebank-agent
JWT_AUDIENCE=safebank-web
JWT_ACCESS_MINUTES=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=10
AUTH_SESSION_DAYS=7
AUTH_REFRESH_COOKIE_NAME=safebank_refresh
AUTH_CSRF_COOKIE_NAME=safebank_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Step-up MFA；建议使用不同于 JWT 的独立随机密钥，至少 32 个字符。
MFA_OTP_PEPPER=
MFA_CODE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=3
MFA_RESEND_COOLDOWN_SECONDS=30

# Channel Gateway：请分别生成至少 32 位的随机密钥，不要与 JWT 或数据库密码复用。
CHANNEL_GATEWAY_SECRET=
CHANNEL_IDENTITY_PEPPER=
CHANNEL_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_GATEWAY_BASE_URL=http://127.0.0.1:8000
CHANNEL_GATEWAY_TIMEOUT_SECONDS=60
# 飞书安全卡片跳转目标；生产环境必须改为受信 HTTPS Web/App 地址。
TRUSTED_APP_BASE_URL=http://127.0.0.1:5173

# 飞书长连接：来自飞书开放平台“凭证与基础信息”。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WORKER_THREADS=1
FEISHU_LOG_LEVEL=INFO
LIFE_RADAR_POLL_SECONDS=30
LIFE_RADAR_BATCH_SIZE=20
LIFE_RADAR_LEASE_SECONDS=120
LIFE_RADAR_MAX_ATTEMPTS=3
LIFE_RADAR_RETRY_BASE_SECONDS=60
# 仅本地比赛演示时设为 true；正式环境必须保持 false。
LIFE_RADAR_SIMULATION_ENABLED=false

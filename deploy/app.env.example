# 复制为仓库根目录 .env.production。这里仅放应用进程所需配置。
TZ=Asia/Shanghai
ENVIRONMENT=production

# DeepSeek
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=10

# MySQL。DB_PASSWORD 必须与 .env.mysql 的 MYSQL_PASSWORD 完全一致。
DATABASE_ENABLED=true
DB_HOST=mysql
DB_PORT=3306
DB_NAME=safebank_agent
DB_USER=safebank_app
DB_PASSWORD=REPLACE_WITH_APP_DATABASE_PASSWORD

# JWT、认证与 Cookie
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=safebank-agent
JWT_AUDIENCE=safebank-web
JWT_ACCESS_MINUTES=10
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=10
AUTH_SESSION_DAYS=7
AUTH_REFRESH_COOKIE_NAME=safebank_refresh
AUTH_CSRF_COOKIE_NAME=safebank_csrf
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# 只在没有域名的临时 HTTP 联调中改为 true；正式部署保持 false。
DEPLOYMENT_ALLOW_INSECURE_HTTP=false

# MFA 与反诈安全密钥必须彼此不同。
MFA_OTP_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
MFA_CODE_TTL_SECONDS=300
MFA_MAX_ATTEMPTS=3
MFA_RESEND_COOLDOWN_SECONDS=30
FRAUD_RECIPIENT_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
FRAUD_COOLING_MINUTES=30
FRAUD_RELEASE_CHALLENGE_TTL_SECONDS=300
FRAUD_RELEASE_MAX_ATTEMPTS=3
GUARDIAN_INVITE_TTL_SECONDS=600

# Channel Gateway。容器之间使用服务名 api 通信，不经过公网。
CHANNEL_GATEWAY_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
CHANNEL_IDENTITY_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
CHANNEL_LINK_TOKEN_TTL_SECONDS=600
CHANNEL_GATEWAY_BASE_URL=http://api:8000
CHANNEL_GATEWAY_TIMEOUT_SECONDS=60
CHANNEL_WORKER_HEARTBEAT_SECONDS=20
CHANNEL_WORKER_LEASE_SECONDS=75

# 替换为实际 HTTPS 地址，末尾不要加斜杠。
TRUSTED_APP_BASE_URL=https://agent.example.com

# 飞书长连接只强制需要 APP_ID 和 APP_SECRET。
FEISHU_APP_ID=REPLACE_WITH_FEISHU_APP_ID
FEISHU_APP_SECRET=REPLACE_WITH_FEISHU_APP_SECRET
FEISHU_WORKER_THREADS=1
FEISHU_LOG_LEVEL=INFO

# 只有启用飞书 Webhook 时才填写下面两项。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_MAX_SKEW_SECONDS=300

# 主动生活事件雷达
LIFE_RADAR_POLL_SECONDS=30
LIFE_RADAR_BATCH_SIZE=20
LIFE_RADAR_LEASE_SECONDS=120
LIFE_RADAR_MAX_ATTEMPTS=3
LIFE_RADAR_RETRY_BASE_SECONDS=60
LIFE_RADAR_SIMULATION_ENABLED=false
